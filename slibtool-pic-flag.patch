+static const char * slbt_lconf_tag_name(enum slbt_tag tag)
+{
+	switch (tag) {
+		case SLBT_TAG_CXX:
+			return "CXX";
+		case SLBT_TAG_FC:
+			return "FC";
+		case SLBT_TAG_F77:
+			return "F77";
+		case SLBT_TAG_RC:
+			return "RC";
+		default:
+			return 0;
+	}
+}
+
+static int slbt_lconf_unquote(
+	const char *	src,
+	char		(*val)[PATH_MAX])
+{
+	const char *	mark;
+	const char *	cap;
+	char		quote;
+
+	while (*src == ' ' || *src == '\t')
+		src++;
+
+	quote = 0;
+	if (*src == '"' || *src == '\'') {
+		quote = *src++;
+		mark  = src;
+		for (cap = mark; *cap && *cap != quote; )
+			cap++;
+		if (*cap != quote)
+			return -1;
+	} else {
+		mark = src;
+		for (cap = mark; *cap && *cap != '\r' && *cap != '\n'; )
+			cap++;
+	}
+
+	if ((size_t)(cap - mark) >= sizeof(*val))
+		return -1;
+
+	memcpy(*val, mark, (size_t)(cap - mark));
+	(*val)[cap - mark] = '\0';
+	return 0;
+}
+
+static int slbt_lconf_key_value(
+	const char *	line,
+	const char *	key,
+	char		(*val)[PATH_MAX])
+{
+	const char *	mark;
+	size_t		klen;
+
+	klen = strlen(key);
+
+	/* key=value */
+	if (!strncmp(line, key, klen) && line[klen] == '=')
+		return slbt_lconf_unquote(&line[klen + 1], val);
+
+	/* config.status: S["key"]="value" */
+	if (!strncmp(line, "S[\"", 3)) {
+		mark = &line[3];
+		if (!strncmp(mark, key, klen)
+				&& !strncmp(&mark[klen], "\"]=", 3))
+			return slbt_lconf_unquote(&mark[klen + 3], val);
+	}
+
+	return 1;
+}
+
+static int slbt_lconf_section_tag(
+	const char *	line,
+	char		(*tag)[16])
+{
+	const char *	mark;
+	const char *	cap;
+	const char	pfx[] = "BEGIN LIBTOOL TAG CONFIG:";
+	size_t		n;
+
+	if (!(mark = strstr(line, pfx)))
+		return 1;
+
+	mark += sizeof(pfx) - 1;
+	while (*mark == ' ' || *mark == '\t')
+		mark++;
+
+	for (cap = mark; *cap && *cap != '\r' && *cap != '\n' && *cap != ' '; )
+		cap++;
+
+	n = (size_t)(cap - mark);
+	if (!n || n >= sizeof(*tag))
+		return 1;
+
+	memcpy(*tag, mark, n);
+	(*tag)[n] = '\0';
+	return 0;
+}
+
+static int slbt_get_lconf_pic_flag(
+	const struct slbt_txtfile_ctx *	tctx,
+	enum slbt_tag			tag,
+	char				(*val)[PATH_MAX])
+{
+	const char **	pline;
+	const char *	want;
+	const char *	line;
+	char		section[16];
+	char		tagged[64];
+	char		found_default[PATH_MAX];
+	char		found_tag[PATH_MAX];
+	char		tmp[PATH_MAX];
+	int		ret;
+
+	want = slbt_lconf_tag_name(tag);
+	section[0] = '\0';
+	found_default[0] = '\0';
+	found_tag[0] = '\0';
+	(*val)[0] = '\0';
+
+	if (want)
+		sprintf(tagged, "pic_flag_%s", want);
+	else
+		tagged[0] = '\0';
+
+	for (pline = tctx->txtlinev; *pline; pline++) {
+		line = *pline;
+
+		if (strstr(line, "BEGIN LIBTOOL CONFIG")
+				&& !strstr(line, "TAG CONFIG")) {
+			section[0] = '\0';
+			continue;
+		}
+
+		if (!slbt_lconf_section_tag(line, &section))
+			continue;
+
+		ret = slbt_lconf_key_value(line, "pic_flag", &tmp);
+		if (!ret) {
+			if (section[0] && want && !strcmp(section, want))
+				strcpy(found_tag, tmp);
+			else if (!section[0] && !found_default[0])
+				strcpy(found_default, tmp);
+			continue;
+		}
+
+		if (tagged[0] && !slbt_lconf_key_value(line, tagged, &tmp)) {
+			strcpy(found_tag, tmp);
+			continue;
+		}
+
+		if (want) {
+			sprintf(tagged, "lt_prog_compiler_pic_%s", want);
+			if (!slbt_lconf_key_value(line, tagged, &tmp)) {
+				strcpy(found_tag, tmp);
+				sprintf(tagged, "pic_flag_%s", want);
+				continue;
+			}
+			sprintf(tagged, "pic_flag_%s", want);
+		}
+
+		if (!slbt_lconf_key_value(line, "lt_prog_compiler_pic", &tmp)
+				&& !found_default[0])
+			strcpy(found_default, tmp);
+	}
+
+	if (found_tag[0])
+		strcpy(*val, found_tag);
+	else
+		strcpy(*val, found_default);
+
+	return 0;
+}
+
+static void slbt_lconf_store_pic_flag(
+	struct slbt_driver_ctx_impl *	ctx,
+	char				(*val)[PATH_MAX])
+{
+	char *	ch;
+	char *	tok;
+	int	px;
+	int	skip;
+
+	ctx->pic_flag = 0;
+	ctx->pic_flag_tok = 0;
+	memset(ctx->picx, 0, sizeof(ctx->picx));
+	ctx->cctx.pic_flag = 0;
+
+	if (!(*val)[0])
+		return;
+
+	if (!(ctx->pic_flag = strdup(*val)))
+		return;
+
+	if (!(ctx->pic_flag_tok = strdup(*val)))
+		return;
+
+	ctx->cctx.pic_flag = ctx->pic_flag;
+
+	/* Keep tokens that GNU libtool would add beyond -fPIC/-DPIC */
+	px = 0;
+	for (ch = ctx->pic_flag_tok; *ch; ) {
+		while (*ch == ' ' || *ch == '\t')
+			ch++;
+		if (!*ch)
+			break;
+
+		tok = ch;
+		while (*ch && *ch != ' ' && *ch != '\t')
+			ch++;
+		if (*ch)
+			*ch++ = '\0';
+
+		skip = !strcmp(tok, "-fPIC")
+			|| !strcmp(tok, "-fpic")
+			|| !strcmp(tok, "-fPIE")
+			|| !strcmp(tok, "-fpie")
+			|| !strcmp(tok, "-DPIC")
+			|| !strcmp(tok, "-DPIE");
+
+		if (!skip && px < SLBT_PICX_MAX)
+			ctx->picx[px++] = tok;
+	}
+}
